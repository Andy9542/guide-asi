__pycache__/
*.pyc
.DS_Store
.venv/

# Побочные файлы прогонов, не часть гайда.
# hits.log остаётся после запуска набора проб: в нём тела запросов к модели,
# то есть сами инъекции. В репозитории ему делать нечего.
hits.log
results.json
.semgrepignore

# Локальные секреты, которых в коммитах быть не должно: .env с токенами; keys/ и *.pem —
# пара Ed25519, которую configs/bus-signing/keygen.sh создаёт там, куда его позвали.
.env
keys/
*.pem
