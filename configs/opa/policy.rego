# Решаемая политика: можно ли агенту записать по этому пути.
#
# Смысл именно в default deny. Список разрешённого, составленный «чтобы работало»,
# однажды окажется списком разрешённого для того, кто найдёт второе применение
# разрешённой команде.
#
# Конкретный запрет ниже — про запись агентом собственного конфига MCP: агент,
# способный переписать список своих инструментов, назначает себе права сам.
package agent.tools

default allow := false

allow if {
	input.path != ".mcp.json"
	not endswith(input.path, "/.mcp.json")
}
