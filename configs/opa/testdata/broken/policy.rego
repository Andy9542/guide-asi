# Фикстура третьего исхода — копия policy.rego с заведомо неверной строкой в конце:
#   POLICY_DIR=testdata/broken sh check.sh .mcp.json   → ИНФРА, код 3, rego_parse_error
# Решаемая политика: можно ли агенту записать по этому пути.
#
# Смысл именно в default deny. Список разрешённого, составленный «чтобы работало»,
# однажды окажется списком разрешённого для того, кто найдёт второе применение
# разрешённой команде.
#
# Конкретный запрет ниже — про запись агентом собственного конфига MCP: агент,
# способный переписать список своих инструментов, назначает себе права сам.
package agent.tools

default allow := false

allow if {
	# is_string обязателен. Без него нестроковый input.path (число, null, объект) роняет
	# lower() в ошибку типа, OPA превращает её в undefined, и запрет получается побочным
	# эффектом, а не решением: у `opa run` нет флага `--strict-builtin-errors`, чтобы это
	# заметить. Первая редакция правила — без lower() — на таком входе РАЗРЕШАЛА запись.
	is_string(input.path)

	not malformed(input.path)
	basename(input.path) != ".mcp.json"
}

# Управляющие символы и NUL — не имя файла, а попытка разъехаться с тем, кто этот путь
# потом откроет. Двоеточие в базовом имени — альтернативный поток NTFS: запись в
# `.mcp.json::$DATA` попадает в тот же файл.
malformed(s) if regex.match(`[\x00-\x1f\x7f]`, s)

malformed(s) if contains(basename(s), ":")

# Сравнение идёт по базовому имени после нормализации, а не по суффиксу пути.
# Нижний регистр: на macOS и Windows файловые системы по умолчанию регистронезависимы,
# и запись в `.MCP.json` перезаписала бы тот самый `.mcp.json`, который защищает политика.
# `\` — разделитель пути на Windows, хвостовые точки и пробелы Windows отбрасывает при
# открытии файла, так что `.mcp.json.` — тот же файл. `..` здесь не схлопывается и файл
# не открывается: симлинки и жёсткие ссылки вне области этого примера.
basename(s) := name if {
	norm := replace(lower(s), "\\", "/")
	parts := [p | some p in split(norm, "/"); p != ""; p != "."]
	count(parts) > 0
	name := trim_right(parts[count(parts) - 1], ". ")
}
